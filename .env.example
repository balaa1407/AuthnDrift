# ==============================================================================
# AuthDrift Environment Configuration Example
# Copy this file to .env and populate appropriate credentials.
# Never commit real API keys or secrets to version control.
# ==============================================================================

# Application Service Configuration
AUTH_DRIFT_HOST=0.0.0.0
AUTH_DRIFT_PORT=8000
AUTH_DRIFT_LOG_LEVEL=INFO

# Threat Intelligence (AbuseIPDB)
# Sign up and obtain a free API key at: https://www.abuseipdb.com/pricing
AUTH_DRIFT_ENABLE_THREAT_INTEL=true
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
ABUSEIPDB_API_URL=https://api.abuseipdb.com/api/v2/check
AUTH_DRIFT_IP_CACHE_TTL=86400

# Optional LLM Calibration Inference (Deterministic research mode works with key unset)
AUTH_DRIFT_LLM_KEY=

# Keycloak Integration (for Docker Compose & Live Integration)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=authdrift

